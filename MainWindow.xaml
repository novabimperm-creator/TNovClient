<Window x:Class="TNovClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TNovClient"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ViewModel}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Title="TNovClient" 
        Width="{Binding WindowWidth}"
        MaxWidth="450"
        Height="780"
        MaxHeight="820"
        ShowInTaskbar="True"  
        ShowActivated="True"
        Topmost="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Фоновый контейнер с тенями и скруглениями -->
        <Border CornerRadius="12"
                Margin="10"
                Background="{DynamicResource BgBrush}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" 
                                  BlurRadius="30" 
                                  Opacity="0.15" 
                                  Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- Верхняя панель с градиентом -->
                <Border Height="40"
                        CornerRadius="12,12,0,0"
                        VerticalAlignment="Top"
                        MouseDown="Border_MouseDown"
                        Background="{DynamicResource AccentBrush}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- Иконка приложения -->
                        <Image Source="logo.ico" 
                               Width="20" 
                               Height="20"
                               Grid.Column="0"
                               Margin="10,0"/>

                        <!-- Заголовок -->
                        <TextBlock Text="{Binding TNovClientVersion}" 
                                   Foreground="{DynamicResource DarkBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Grid.Column="1"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                    </Grid>
                </Border>

                <!-- Основное содержимое -->
                <Border Margin="0,40,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TabControl x:Name="MainTabControl"
                                    Grid.Row="0"
                                    Style="{StaticResource MainTabControlStyle}"
                                    ItemContainerStyle="{StaticResource MainTabItemStyle}">
                            <TabItem Header="Модули">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Список модулей, сгруппированный по конфигурациям -->
                                    <ItemsControl Grid.Row="0"
                                                  Margin="0,0,0,10"
                                                  ItemsSource="{Binding ModuleGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource GroupHeaderTextStyle}"/>
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  MaxHeight="180">
                                                        <ItemsControl ItemsSource="{Binding Modules}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource ModuleCardStyle}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       Grid.Column="0"
                                                                                       Style="{StaticResource ModuleNameTextStyle}"
                                                                                       FontWeight="Bold"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <StackPanel Grid.Column="1"
                                                                                        Margin="6,0,8,0"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Text="Текущая"
                                                                                           Style="{StaticResource VersionTextStyle}"/>
                                                                                <TextBlock Text="{Binding CurrentVersion}"
                                                                                           Style="{StaticResource TitleTextStyle}"
                                                                                           HorizontalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Text="Актуальная"
                                                                                           Style="{StaticResource VersionTextStyle}"/>
                                                                                <TextBlock Text="{Binding ActualVersion}"
                                                                                           Style="{StaticResource TitleTextStyle}"
                                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                                           HorizontalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <Button Grid.Column="3"
                                                                                    Style="{StaticResource DesktopActionButtonStyle}"
                                                                                    Content="{Binding DesktopActionText}"
                                                                                    Width="{Binding DesktopActionWidth}"
                                                                                    ToolTip="{Binding DesktopActionToolTip}"
                                                                                    Visibility="{Binding IsDesktopActionVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                    Command="{Binding DataContext.DesktopRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Margin="6,0,0,0"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Кнопка перехода к журналу версий -->
                                    <StackPanel Grid.Row="1" 
                                                Orientation="Horizontal" 
                                                HorizontalAlignment="Center"
                                                Margin="0,10,0,10">
                                        <Button Style="{StaticResource ModernButtonStyle}"
                                                Content="Журнал версий"
                                                Click="JournalTab_Click"
                                                Width="160"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Журнал">
                                <Grid MinHeight="420">
                                    <Grid Visibility="{Binding HasReleaseEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ScrollViewer Grid.Column="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ListBox ItemsSource="{Binding ReleaseEntries}"
                                                     SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                                                     Style="{StaticResource JournalListBoxStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ReleaseDate}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       Margin="0,0,0,4"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding ModuleName}"
                                                                           Grid.Column="0"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Grid.Column="1"
                                                                        Style="{StaticResource GreenBadgeStyle}"
                                                                        Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding Version}"
                                                                               Foreground="{DynamicResource DarkBrush}"
                                                                               FontSize="11"
                                                                               FontWeight="Medium"/>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <ScrollViewer Grid.Column="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding SelectedRelease.Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardBrush}"
                                                                CornerRadius="6"
                                                                Padding="8,6"
                                                                Margin="0,0,0,4">
                                                            <StackPanel>
                                                                <Border Style="{StaticResource GreenBadgeStyle}"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="0,0,0,6">
                                                                    <TextBlock Text="{Binding TypeLabel}"
                                                                               Foreground="{DynamicResource DarkBrush}"
                                                                               FontSize="11"
                                                                               FontWeight="Medium"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Text}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <TextBlock Text="{Binding JournalStatusMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,40,0,40"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasReleaseEntries}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Конфигурация">
                                <Grid MinHeight="420">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Style="{StaticResource InfoCardStyle}"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Компания"
                                                       Style="{StaticResource SubtitleTextStyle}"/>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Text="{Binding actualcompany}"
                                                       Style="{StaticResource TitleTextStyle}"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Если вы из другого подразделения, напишите на почту bim@pm-nova.ru."
                                                       Style="{StaticResource SubtitleTextStyle}"/>
                                            <TextBlock Text="Для обновления плагина закройте Revit."
                                                       Style="{StaticResource SubtitleTextStyle}"/>
                                            <Button Style="{StaticResource ModernButtonStyle}"
                                                    Content="Собрать логи"
                                                    ToolTip="Архив с логами клиента и плагина на рабочем столе — отправьте его разработчикам"
                                                    Command="{Binding CollectLogsCommand}"
                                                    Width="220"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding IsPersonalConfig, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,10">
                                        <Button Style="{StaticResource ModernButtonStyle}"
                                                Content="Сменить конфигурацию"
                                                Command="{Binding ShowConfigurationPickerCommand}"
                                                Width="220"
                                                Visibility="{Binding ShowConfigurationPicker, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                        <ItemsControl ItemsSource="{Binding ConfigurationOptions}"
                                                      Visibility="{Binding ShowConfigurationPicker, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding DisplayName}"
                                                            Style="{StaticResource ConfigurationPickerButtonStyle}"
                                                            Command="{Binding DataContext.SelectConfigurationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Style="{StaticResource ModernButtonStyle}"
                                                Content="Назад"
                                                Command="{Binding CloseConfigurationPickerCommand}"
                                                Width="220"
                                                Margin="0,4,0,0"
                                                Visibility="{Binding ShowConfigurationPicker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Кнопки действий -->
                        <StackPanel Grid.Row="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,20">
                            <Button Style="{StaticResource ModernButtonStyle}" 
                                    Content="Закрыть" 
                                    Name="Min" 
                                    Click="Min_Click" 
                                    Width="120"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Иконка в системном трее -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Visibility="Visible"
                        ToolTipText="TNovClient" 
                        IconSource="logo.ico" 
                        TrayLeftMouseDown="TaskbarIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Открыть" Click="ShowWindow_Click"/>
                    <MenuItem Header="Выйти" Click="ExitApp_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>