<Window x:Class="TNovClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TNovClient"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ViewModel}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Title="TNovClient" 
        Width="{Binding WindowWidth}"
        MaxWidth="450"
        Height="780"
        MaxHeight="820"
        ShowInTaskbar="True"  
        ShowActivated="True"
        Topmost="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
       
        <!-- Современный стиль для кнопок -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF008E43"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" 
                                        Property="Background" 
                                        Value="#FF00AA55"/>
                                <Setter TargetName="border" 
                                        Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" 
                                        Property="Background" 
                                        Value="#FF007E33"/>
                                <Setter TargetName="border" 
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DesktopActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ConfigurationPickerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FF007E33"/>
                    <Setter Property="BorderBrush" Value="#FF005A25"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для текстовых блоков -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>

        <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="VersionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModuleNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>

        <Style x:Key="GroupHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF008E43"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>

        <Style x:Key="GreenBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF008E43"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReleaseListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="cardBorder"
                                Background="#F5F9FF"
                                CornerRadius="6"
                                Padding="8,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#E0F2E8"/>
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#FF008E43"/>
                                <Setter TargetName="cardBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#EEF7F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="JournalListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ReleaseListItemStyle}"/>
        </Style>

        <!-- Стиль для информационных карточек -->
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#F5F5F5"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8,0,0">
                                <TabPanel IsItemsHost="True"
                                          HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="Transparent"
                                    Padding="0,10,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF008E43"/>
                                <Setter Property="Foreground" Value="#FF008E43"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FF00AA55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточки модуля с подсветкой неактуальных -->
        <Style x:Key="ModuleCardStyle" 
TargetType="Border" 
BasedOn="{StaticResource InfoCardStyle}">
            <!-- Фон по умолчанию (такой же, как был задан явно) -->
            <Setter Property="Background" Value="#F5F9FF"/>
            <Style.Triggers>
                <!-- Если модуль не актуален (IsActual == False) -->
                <DataTrigger Binding="{Binding IsActual}" Value="False">
                    <Setter Property="Background" Value="#FFE5E5"/>
                    <!-- светло-красный -->
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Фоновый контейнер с тенями и скруглениями -->
        <Border CornerRadius="12"
                Margin="10">
            <Border.Background>
                <SolidColorBrush Color="White"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" 
                                  BlurRadius="30" 
                                  Opacity="0.15" 
                                  Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- Верхняя панель с градиентом -->
                <Border Height="40" 
                        CornerRadius="12,12,0,0"
                        VerticalAlignment="Top"
                        MouseDown="Border_MouseDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF008E43" Offset="0"/>
                            <GradientStop Color="#FF00AA55" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- Иконка приложения -->
                        <Image Source="logo.ico" 
                               Width="20" 
                               Height="20"
                               Grid.Column="0"
                               Margin="10,0"/>

                        <!-- Заголовок -->
                        <TextBlock Text="{Binding TNovClientVersion}" 
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Grid.Column="1"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                    </Grid>
                </Border>

                <!-- Основное содержимое -->
                <Border Margin="0,40,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TabControl x:Name="MainTabControl"
                                    Grid.Row="0"
                                    Style="{StaticResource MainTabControlStyle}"
                                    ItemContainerStyle="{StaticResource MainTabItemStyle}">
                            <TabItem Header="Модули">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Список модулей, сгруппированный по конфигурациям -->
                                    <ItemsControl Grid.Row="0"
                                                  Margin="0,0,0,10"
                                                  ItemsSource="{Binding ModuleGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource GroupHeaderTextStyle}"/>
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  MaxHeight="180">
                                                        <ItemsControl ItemsSource="{Binding Modules}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource ModuleCardStyle}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       Grid.Column="0"
                                                                                       Style="{StaticResource ModuleNameTextStyle}"
                                                                                       FontWeight="Bold"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <StackPanel Grid.Column="1"
                                                                                        Margin="6,0,8,0"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Text="Текущая"
                                                                                           Style="{StaticResource VersionTextStyle}"/>
                                                                                <TextBlock Text="{Binding CurrentVersion}"
                                                                                           Style="{StaticResource TitleTextStyle}"
                                                                                           HorizontalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Text="Актуальная"
                                                                                           Style="{StaticResource VersionTextStyle}"/>
                                                                                <TextBlock Text="{Binding ActualVersion}"
                                                                                           Style="{StaticResource TitleTextStyle}"
                                                                                           Foreground="#FF008E43"
                                                                                           HorizontalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <Button Grid.Column="3"
                                                                                    Style="{StaticResource DesktopActionButtonStyle}"
                                                                                    Content="{Binding DesktopActionText}"
                                                                                    Width="{Binding DesktopActionWidth}"
                                                                                    ToolTip="{Binding DesktopActionToolTip}"
                                                                                    Visibility="{Binding IsDesktopActionVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                    Command="{Binding DataContext.DesktopRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Margin="6,0,0,0"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Кнопка перехода к журналу версий -->
                                    <StackPanel Grid.Row="1" 
                                                Orientation="Horizontal" 
                                                HorizontalAlignment="Center"
                                                Margin="0,10,0,10">
                                        <Button Style="{StaticResource ModernButtonStyle}"
                                                Content="Журнал версий"
                                                Click="JournalTab_Click"
                                                Width="160"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Журнал">
                                <Grid MinHeight="420">
                                    <Grid Visibility="{Binding HasReleaseEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ScrollViewer Grid.Column="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ListBox ItemsSource="{Binding ReleaseEntries}"
                                                     SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                                                     Style="{StaticResource JournalListBoxStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ReleaseDate}"
                                                                       FontSize="10"
                                                                       Foreground="#999999"
                                                                       Margin="0,0,0,4"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding ModuleName}"
                                                                           Grid.Column="0"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#1A1A1A"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Grid.Column="1"
                                                                        Style="{StaticResource GreenBadgeStyle}"
                                                                        Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding Version}"
                                                                               Foreground="White"
                                                                               FontSize="11"
                                                                               FontWeight="Medium"/>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <ScrollViewer Grid.Column="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding SelectedRelease.Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F5F9FF"
                                                                CornerRadius="6"
                                                                Padding="8,6"
                                                                Margin="0,0,0,4">
                                                            <StackPanel>
                                                                <Border Style="{StaticResource GreenBadgeStyle}"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="0,0,0,6">
                                                                    <TextBlock Text="{Binding TypeLabel}"
                                                                               Foreground="White"
                                                                               FontSize="11"
                                                                               FontWeight="Medium"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Text}"
                                                                           FontSize="12"
                                                                           Foreground="#1A1A1A"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <TextBlock Text="{Binding JournalStatusMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,40,0,40"/>
                                                <Setter Property="Foreground" Value="#999999"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasReleaseEntries}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Конфигурация">
                                <Grid MinHeight="420">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Style="{StaticResource InfoCardStyle}"
                                            Margin="0,0,0,10">
                                        <Border.Background>
                                            <SolidColorBrush Color="#FFF9F5"/>
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="Компания"
                                                       Style="{StaticResource SubtitleTextStyle}"/>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Text="{Binding actualcompany}"
                                                       Style="{StaticResource TitleTextStyle}"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Если вы из другого подразделения, напишите на почту bim@pm-nova.ru."
                                                       Style="{StaticResource SubtitleTextStyle}"/>
                                            <TextBlock Text="Для обновления плагина закройте Revit."
                                                       Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,10">
                                        <Button Style="{StaticResource ModernButtonStyle}"
                                                Content="Сменить конфигурацию"
                                                Command="{Binding ShowConfigurationPickerCommand}"
                                                Width="220"
                                                Visibility="{Binding ShowConfigurationPicker, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                        <ItemsControl ItemsSource="{Binding ConfigurationOptions}"
                                                      Visibility="{Binding ShowConfigurationPicker, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding DisplayName}"
                                                            Style="{StaticResource ConfigurationPickerButtonStyle}"
                                                            Command="{Binding DataContext.SelectConfigurationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Style="{StaticResource ModernButtonStyle}"
                                                Content="Назад"
                                                Command="{Binding CloseConfigurationPickerCommand}"
                                                Width="220"
                                                Margin="0,4,0,0"
                                                Visibility="{Binding ShowConfigurationPicker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Кнопки действий -->
                        <StackPanel Grid.Row="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,20">
                            <Button Style="{StaticResource ModernButtonStyle}" 
                                    Content="Закрыть" 
                                    Name="Min" 
                                    Click="Min_Click" 
                                    Width="120"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Иконка в системном трее -->
        <tb:TaskbarIcon Visibility="Visible" 
                        ToolTipText="TNovClient" 
                        IconSource="logo.ico" 
                        TrayLeftMouseDown="TaskbarIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Открыть" Click="ShowWindow_Click"/>
                    <MenuItem Header="Выйти" Click="ExitApp_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>